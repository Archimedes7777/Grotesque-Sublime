{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(.git/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git config core.hooksPath *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git config core.hooksPath *)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/skills/**)",
      "Edit(.agents/skills/**)",
      "Edit(skills-lock.json)",
      "Edit(scripts/verify-skills.mjs)",
      "Edit(scripts/test-guard.sh)",
      "Edit(scripts/check-cloud-env.sh)",
      "Edit(scripts/lint.sh)",
      "Edit(tools/lint-requirements.lock)",
      "Edit(tools/build-lint-lock.py)",
      "Edit(.yamllint.yml)",
      "Edit(.github/workflows/**)",
      "Edit(.mcp.json)",
      "Edit(SECURITY.md)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Bash(npx *)",
      "Bash(bunx *)",
      "Bash(pnpm dlx *)",
      "Bash(uvx *)",
      "Bash(pipx run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv pip install *)",
      "Bash(brew install *)",
      "Bash(go install *)",
      "Bash(cargo install *)",
      "Bash(gh extension install *)",
      "Bash(claude mcp add *)",
      "Bash(git push --force-with-lease *)",
      "Bash(winget install *)",
      "Bash(choco install *)",
      "Bash(scoop install *)",
      "PowerShell(npx *)",
      "PowerShell(bunx *)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(uvx *)",
      "PowerShell(pipx run *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(pnpm add *)",
      "PowerShell(yarn add *)",
      "PowerShell(pip install *)",
      "PowerShell(pip3 install *)",
      "PowerShell(uv pip install *)",
      "PowerShell(go install *)",
      "PowerShell(cargo install *)",
      "PowerShell(gh extension install *)",
      "PowerShell(claude mcp add *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(winget install *)",
      "PowerShell(choco install *)",
      "PowerShell(scoop install *)",
      "PowerShell(Install-Module *)",
      "PowerShell(Install-Package *)",
      "PowerShell(Install-Script *)",
      "mcp__plugin_postiz_postiz",
      "mcp__postiz",
      "mcp__Gmail__send_message",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__claude_ai_Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__claude_ai_Gmail__forward",
      "mcp__Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__Google_Calendar__respond_to_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "mcp__Notion__notion-delete-pages",
      "mcp__claude_ai_Notion__notion-delete-pages",
      "mcp__Notion__notion-delete-databases",
      "mcp__claude_ai_Notion__notion-delete-databases",
      "mcp__Replit__publish_app",
      "mcp__claude_ai_Replit__publish_app",
      "mcp__Malwarebytes__reputation-report",
      "mcp__claude_ai_Malwarebytes__reputation-report",
      "mcp__ElevenLabs__agents_submit_batch_call",
      "mcp__claude_ai_ElevenLabs__agents_submit_batch_call",
      "mcp__ElevenLabs__agents_create_phone_number",
      "mcp__claude_ai_ElevenLabs__agents_create_phone_number",
      "mcp__ElevenLabs__agents_delete",
      "mcp__claude_ai_ElevenLabs__agents_delete",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__actions_run_trigger",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ]
  },
  "enableAllProjectMcpServers": false,
  "disableSkillShellExecution": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-skills-on-start.sh\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Verifying skill integrity"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/zero-trust-guard.sh\"",
            "shell": "bash",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
